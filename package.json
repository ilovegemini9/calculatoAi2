{
  "name": "workspace",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.12.1",
  "workspaces": [
    "artifacts/*",
    "lib/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @workspace/calculator-platform dev",
    "build": "pnpm --filter @workspace/calculator-platform build",
    "start": "pnpm --filter @workspace/calculator-platform start",
    "lint": "pnpm --filter @workspace/calculator-platform lint",
    "test": "pnpm --filter @workspace/calculator-platform test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "next": "^15.3.4",
    "prettier": "^3.9.4",
    "typescript": "~5.9.3"
  }
}
