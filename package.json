{
  "name": "workspace",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "artifacts/*",
    "lib/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@workspace/calculator-platform",
    "build": "npm run build --workspace=@workspace/calculator-platform",
    "start": "npm run start --workspace=@workspace/calculator-platform",
    "lint": "npm run lint --workspace=@workspace/calculator-platform",
    "test": "npm run test --workspace=@workspace/calculator-platform",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.9.4",
    "typescript": "~5.9.3"
  }
}
